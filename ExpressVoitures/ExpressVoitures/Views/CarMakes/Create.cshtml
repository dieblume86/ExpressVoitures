@model ExpressVoitures.Models.ViewModels.CarMakeViewModel

@{
	ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>CarMake</h4>
<hr />
@if (TempData["Success"] != null)
{
	<div class="mt-3 alert alert-success" role="alert">
		@TempData["Success"]
	</div>
}
<form asp-action="Create" method="post">
	<div class="mb-3 col-6">
		<label>Nom:</label>
		<input asp-for="Name" class="form-control" />
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>
	<div class="text-center">
		<input class="btn btn-primary" type="submit" value="OK" />
	</div>
</form>

@{
	var items = ViewData["ExistingItems"] as IEnumerable<ExpressVoitures.Models.ViewModels.CarMakeViewModel>;

	<h4>Marques existantes</h4>

	if (items != null && items.Any())
	{
		@foreach (var item in items)
		{
			<div class="row">
				<div class="col-8">
					<span>@item.Name</span>
				</div>		
				<div class="col-4">
					<form id="@item.Id" asp-action="Delete" asp-controller="CarMakes" method="post">
						<input type="hidden" name="id" value="@item.Id" />
						<button type="submit" class="btn btn-danger">"Delete"</button>
					</form>
				</div>
			</div>
		}
	}
}


