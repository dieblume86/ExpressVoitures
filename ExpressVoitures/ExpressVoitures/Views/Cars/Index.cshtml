@model IEnumerable<ExpressVoitures.Models.ViewModels.CarViewModel>

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

@{
	ViewData["Title"] = "Test";
}
<div class="container text-center">
	<h1 class="mb-4">Nos voitures</h1>
	@if (User?.Identity?.IsAuthenticated == true)
	{
		<div class="button">
			<a asp-action="Create" asp-controller="Cars">+ Ajouter une voiture</a>
		</div>
	}
</div>

<div class="container">
	<div class="row g-0">
		@for (var i = 0; i < Model.Count(); i++)
		{
			if (i % 2 == 0)
			{
				<div class="row gy-3">
					<div class="col-md-12 col-lg-6 px-lg-3">
						@await Html.PartialAsync("_CarDetails", Model.ElementAt(i))
					</div>

					@if (i + 1 < Model.Count())
					{
						<div class="col-md-12 col-lg-6 px-lg-3">
							@await Html.PartialAsync("_CarDetails", Model.ElementAt(i + 1))
						</div>
					}
				</div>
			}
		}
	</div>
</div>
