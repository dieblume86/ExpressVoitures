@using ExpressVoitures.Helpers
@model ExpressVoitures.Models.ViewModels.CarViewModel

@{
	ViewData["Title"] = "Edit";
	var placeholder = Url.Content("~/images/carImagePlaceHolder.JPG");
	var pictureUrl = string.IsNullOrEmpty(Model?.PictureId) ? placeholder : Url.Action("GetPicture", "Cars", new { pictureId = Model.PictureId });
	string FormatDisplay(DateTimeOffset? d) => d.HasValue ? d.Value.ToString("dd'/'MM'/'yyyy") : string.Empty;
}

<h1>Modifier la voiture</h1>

@await Html.PartialAsync("_ErrorCreateDelete")

<form asp-action="Edit" method="post" enctype="multipart/form-data">
	@Html.AntiForgeryToken()
	<input asp-for="Id" type="hidden" />
	<input asp-for="PictureId" type="hidden" />

	<div class="mb-3 col-6">
		<label>Marque:</label>
		<select id="makeSelect" class="form-select" asp-items="ViewBag.Makes">
			<option value="">-- Choisir --</option>
		</select>
	</div>

	<div class="mb-3 col-6">
		<label>Modèle:</label>
		<select id="modelSelect" asp-for="Trim.ModelId" class="form-select" asp-items="ViewBag.Models">
			<option value="">-- Choisir --</option>
		</select>
		<span asp-validation-for="Trim.ModelId" class="text-danger"></span>
	</div>

	<div class="mb-3 col-6">
		<label>Finition:</label>
		<select id="trimSelect" asp-for="TrimId" class="form-select" asp-items="ViewBag.Trims">
			<option value="">-- Choisir --</option>
		</select>
		<span asp-validation-for="TrimId" class="text-danger"></span>
	</div>

	<div class="mb-3 col-6">
		<label>VIN code:</label>
		<input asp-for="VinCode" class="form-control" />
		<span asp-validation-for="VinCode" class="text-danger"></span>
	</div>
	<div class="mb-3 col-6">
		<label>Année :</label>
		<input asp-for="Year" class="form-control" />
		<span asp-validation-for="Year" class="text-danger"></span>
	</div>

	<div class="mb-3 col-6">
		<label>Photo (jpg/png, max 5MB) :</label>
		<div class="mb-2">
			<img id="picturePreview" src="@pictureUrl" alt="Aperçu photo" class="img-thumbnail" style="max-width:260px; max-height:160px;" />
		</div>
		<input asp-for="PictureFile" id="pictureFileInput" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif" />
		<span asp-validation-for="PictureFile" class="text-danger"></span>
	</div>

	<div class="text-center">
		<button class="btn btn-primary" type="submit">Enregistrer</button>
		<a asp-action="Create" class="btn btn-secondary ms-2">Annuler</a>
	</div>
</form>

@{
	var sale = ViewData[ViewDataKeys.Sales] as ExpressVoitures.Models.ViewModels.CarSaleViewModel;

	<h4>Fiche de vente</h4>

	if (sale == null)
	{

		<div class="button mb-3 col-2">
			<a asp-controller="CarSales" asp-action="Create" asp-route-carId="@Model.Id">Créer fiche de vente</a>
		</div>
	}
	else
	{
		<table class="table table-bordered table-striped table-sm">
			<thead>
				<tr>
					<th>
						<label>PurchaseDate</label>
					</th>
					<th>
						<label>AvailableForSaleDate</label>
					</th>
					<th>
						<label>PurchasePrice</label>
					</th>
					<th>
						<label>SalePrice</label>
					</th>
					<th>
						<label>SaleDate</label>
					</th>
					<th>
						<label>Actions</label>
					</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td>@FormatDisplay(sale.PurchaseDate)</td>
					<td>@FormatDisplay(sale?.AvailableForSaleDate)</td>
					<td style="text-align:center">@sale.PurchasePrice</td>
					<td style="text-align:center">@sale.SalePrice</td>
					<td>@FormatDisplay(sale?.SaleDate)</td>
					<td>
						<form id="deleteRepair_@sale.Id" asp-action="Delete" asp-controller="CarSales" method="post" class="d-inline" ;">
							@Html.AntiForgeryToken()
							<input type="hidden" name="Id" value="@sale.Id" />
							<input type="hidden" name="CarId" value="@sale.CarId" />
							<button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
						</form>
						<a asp-action="Delete" asp-controller="CarSales" asp-route-id="@sale.Id" class="btn btn-sm btn-secondary ms-1">Supprimer</a>
					</td>
				</tr>
			</tbody>
		</table>
	}




	<h4>Réparations</h4>

	<form asp-action="Create" asp-controller="Repairs" method="post">
		@Html.AntiForgeryToken()
		<input type="hidden" name="CarId" value="@Model.Id" />
		<div class="row">
			<div class="mb-3 col-6">
				<label>Nom:</label>
				<input name="Description" class="form-control" />
				<span class="text-danger" data-valmsg-for="Description" data-valmsg-replace="true"></span>
			</div>
			<div class="mb-3 col-3">
				<label>Coût (€) :</label>
				<input name="RepairCost" type="number" step="0.01" class="form-control" value="0" />
				<span class="text-danger" data-valmsg-for="RepairCost" data-valmsg-replace="true"></span>
			</div>
			<div class="text-center col-3">
				<input class="btn btn-primary" type="submit" value="OK" />
			</div>
		</div>
	</form>

	var repairs = ViewData[ViewDataKeys.Repairs] as IEnumerable<ExpressVoitures.Models.ViewModels.RepairViewModel>;

	if (repairs != null && repairs.Any())
	{
		<div class="row">
			<div class="col-5"><strong>Description</strong></div>
			<div class="col-5"><strong>Coût</strong></div>
			<div class="col-2 text-end"><strong>Actions</strong></div>
		</div>

		@foreach (var repair in repairs)
		{
			<div class="row border-top py-2 align-items-center">
				<div class="col-5">
					@repair.Description
				</div>
				<div class="col-5">
					@repair.RepairCost.ToString("0.00") €
				</div>
				<div class="col-2 text-end">
					<form id="deleteRepair_@repair.Id" asp-action="Delete" asp-controller="Repairs" method="post" class="d-inline" onsubmit="return confirm('Confirmer la suppression ?');">
						@Html.AntiForgeryToken()
						<input type="hidden" name="Id" value="@repair.Id" />
						<input type="hidden" name="CarId" value="@repair.CarId" />
						<button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
					</form>
					<a asp-action="Edit" asp-controller="Repairs" asp-route-id="@repair.Id" class="btn btn-sm btn-secondary ms-1">Éditer</a>
				</div>
			</div>
		}
		// @foreach (var item in items)
		// {
		// 	@await Html.PartialAsync("_RepairDetails", item)
		// }
	}
}

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			var makeSelect = document.getElementById('makeSelect');
			var modelSelect = document.getElementById('modelSelect');
			var trimSelect = document.getElementById('trimSelect');

			function clearModels() {
				modelSelect.innerHTML = '<option value="">-- Choisir --</option>';
			}
			function clearTrims() {
				trimSelect.innerHTML = '<option value="">-- Choisir --</option>';
			}

			makeSelect?.addEventListener('change', function () {
				var makeId = this.value;
				clearModels();
				clearTrims();

				if (!makeId)
					return;

				fetch('@Url.Action("GetModelsByMake", "CarModels")?makeId=' + encodeURIComponent(makeId))
					.then(function (res) { return res.json(); })
					.then(function (data) {
						data.forEach(function (m) {
							var opt = document.createElement('option');
							opt.value = m.id;
							opt.text = m.name;
							modelSelect.appendChild(opt);
						});
					})
					.catch(function (err) { console.error(err); });
			});

			modelSelect?.addEventListener('change', function () {
				var modelId = this.value;
				clearTrims();

				if (!modelId)
					return;

				fetch('@Url.Action("GetTrimsByModel", "CarTrims")?modelId=' + encodeURIComponent(modelId))
					.then(function (res) { return res.json(); })
					.then(function (data) {
						data.forEach(function (m) {
							var opt = document.createElement('option');
							opt.value = m.id;
							opt.text = m.name;
							trimSelect.appendChild(opt);
						});
					})
					.catch(function (err) { console.error(err); });
			});

			// Preview file input
			var fileInput = document.getElementById('pictureFileInput');
			var preview = document.getElementById('picturePreview');

			fileInput?.addEventListener('change', function (e) {
				var file = this.files && this.files[0];
				if (!file) {
					// restore existing picture or placeholder (server-side set)
					return;
				}
				var reader = new FileReader();
				reader.onload = function (ev) {
					preview.src = ev.target.result;
				};
				reader.readAsDataURL(file);
			});
		});
	</script>
}