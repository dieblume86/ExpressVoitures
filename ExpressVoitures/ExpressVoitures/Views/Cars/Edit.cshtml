@model ExpressVoitures.Models.Entities.Car

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Car</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="VinCode" class="control-label"></label>
                <input asp-for="VinCode" class="form-control" />
                <span asp-validation-for="VinCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Year" class="control-label"></label>
                <input asp-for="Year" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Trim.Model.MakeId" class="control-label"></label>
                <select asp-for="Trim.Model.MakeId" class="form-control" asp-items="ViewBag.MakeId"></select>
                <span asp-validation-for="Trim.Model.MakeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Trim.ModelId" class="control-label"></label>
                <select asp-for="Trim.ModelId" class="form-control" asp-items="ViewBag.ModelId"></select>
                <span asp-validation-for="Trim.ModelId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TrimId" class="control-label"></label>
                <select asp-for="TrimId" class="form-control" asp-items="ViewBag.TrimId"></select>
                <span asp-validation-for="TrimId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
