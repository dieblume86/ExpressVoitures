@model ExpressVoitures.Models.ViewModels.CarViewModel

<link rel="stylesheet" href="~/css/carItem.css" asp-append-version="true" />

@{
	var placeholder = Url.Content("~/images/carImagePlaceHolder.JPG");
	var pictureUrl = string.IsNullOrEmpty(Model?.PictureId) ? placeholder : Url.Action("GetPicture", "Cars", new { pictureId = Model.PictureId });

	string FormatDisplay(DateTimeOffset d) => d.ToString("dd'/'MM'/'yyyy");
}

<a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark">
	<div class="row car-item">
		<div class="col-md-12 col-lg-8 bg-secondary rounded-3">
			<img src="@pictureUrl"
				 alt="Photo voiture"
				 class="img-fluid"
				 onerror="this.src='@placeholder'; this.onerror=null;" />
		</div>
		<div class="col-md-12 col-lg-4 bg-light d-flex align-items-center py">
			<ul class="listNoType">
				@if (Model?.Sale?.SaleDate != null)
				{
					<li><span>Vendu</span></li>
					<br />
				}
		
				<li><strong>Prix de vente : @Model?.Sale?.SalePrice€</strong></li>
				<br />
				<li>Année : @Model.Year</li>
				<li>Marque : @Model.Trim.Model.Make?.Name</li>
				<li>Modèle : @Model.Trim.Model?.Name</li>
				<li>Finition : @Model.Trim?.Name</li>
				@if (Model?.Sale?.AvailableForSaleDate != null && Model?.Sale?.SaleDate == null)
				{
					<br/>
					<li>Disponible depuis le @FormatDisplay(Model.Sale.AvailableForSaleDate.Value)</li>
				}
			</ul>
		</div>
	</div>

	@if (User?.Identity?.IsAuthenticated == true)
	{
		<a asp-action="Edit" asp-controller="Cars" asp-route-id="@Model.Id" class="btn btn-sm btn-secondary">Éditer</a>
	}
</a>