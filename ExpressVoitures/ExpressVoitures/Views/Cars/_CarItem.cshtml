@using ExpressVoitures.Models.ViewModels

<link rel="stylesheet" href="~/css/carItem.css" asp-append-version="true" />

<div class="row car-item">
	<div class="col-md-12 col-lg-8 bg-secondary rounded-3">
		<a asp-action="SingleCar" asp-controller="Cars" asp-route-id="@Model.Id">
			<img src="~/images/carImagePlaceHolder.JPG" />
		</a>

	</div>
	<div class="col-md-12 col-lg-4 bg-light d-flex align-items-center py">
		<ul class="listNoType">
			<li><span>Prix de vente</span></li>
			<li>@Model.Year</li>
			<li>@Model.MakeId</li>
			<li>@Model.ModelId</li>
			<li>@Model.TrimId</li>
		</ul>
	</div>
</div>