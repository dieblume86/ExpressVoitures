@model ExpressVoitures.Models.ViewModels.CarViewModel

@{
	ViewData["Title"] = "Create";
}
<div><p>Créer une nouvelle voiture</p></div>

@await Html.PartialAsync("_ErrorCreateDelete")

<form asp-action="Create" method="post">
	<div class="row">
		<div class="mb-3 col-6">
			<label>Marque:</label>
			<select asp-for="MakeId" id="makeSelect" class="form-select" asp-items="ViewBag.Makes">
				<option value="">-- Choisir --</option>
			</select>
			<span asp-validation-for="MakeId" class="text-danger"></span>
		</div>
		<div class="mb-3 col-2">
			<a class="button-square" asp-action="Create" asp-controller="CarMakes">+</a>
		</div>
	</div>
	<div class="row">
		<div class="mb-3 col-6">
			<label>Modèle:</label>
			<select asp-for="ModelId" id="modelSelect" class="form-select" asp-items="ViewBag.Models">
				<option value="">-- Choisir --</option>
			</select>
			<span asp-validation-for="ModelId" class="text-danger"></span>
		</div>
		<div class="mb-3 col-2">
			<a class="button-square" asp-action="Create" asp-controller="CarModels">+</a>
		</div>
	</div>
	<div class="row">
		<div class="mb-3 col-6">
			<label>Finition:</label>
			<select asp-for="TrimId" id="trimSelect" class="form-select" asp-items="ViewBag.Trims">
				<option value="">-- Choisir --</option>
			</select>
			<span asp-validation-for="TrimId" class="text-danger"></span>
		</div>
		<div class="mb-3 col-2">
			<a class="button-square" asp-action="Create" asp-controller="CarTrims">+</a>
		</div>
	</div>



	<div class="mb-3 col-6">
		<label>VIN code:</label>
		<input asp-for="VinCode" class="form-control" />
		<span asp-validation-for="VinCode" class="text-danger"></span>
	</div>

	<div class="mb-3 col-6">
		<label>Année :</label>
		<input asp-for="Year" class="form-control" />
		<span asp-validation-for="Year" class="text-danger"></span>
	</div>

	<div class="text-center">
		<input class="btn btn-primary" type="submit" value="OK" />
	</div>
</form>

@{
	var items = ViewData["ExistingItems"] as IEnumerable<ExpressVoitures.Models.ViewModels.CarViewModel>;

	<h4>Voitures existantes</h4>

	if (items != null && items.Any())
	{
		<div class="row">
			<div class="col-2">
				<span>VIN code</span>
			</div>
			<div class="col-2">
				<span>Année</span>
			</div>
			<div class="col-2">
				<span>Marque</span>
			</div>
			<div class="col-2">
				<span>Modèle</span>
			</div>
			<div class="col-2">
				<span>Finition</span>
			</div>
			<div class="col-2">
				<span>Supprimer</span>
			</div>
		</div>
		@foreach (var item in items)
		{
			<div class="row border-top py-2">
				<div class="col-2">
					<span>@item.VinCode</span>
				</div>
				<div class="col-2">
					<span>@item.Year</span>
				</div>
				<div class="col-2">
					@{
						var makeName = item.Model?.Make?.Name ?? "(Marque inconnue)";
					}
					<span>@makeName</span>
				</div>
				<div class="col-2">
					@{
						var modelName = item.Model?.Name ?? "(Modèle inconnu)";
					}
					<span>@modelName</span>
				</div>
				<div class="col-2">
					@{
						var trimName = item.Trim?.Name ?? "(Finition inconnue)";
					}
					<span>@trimName</span>
				</div>
				<div class="col-2">
					<form id="@item.Id" asp-action="Delete" asp-controller="Cars" method="post">
						<input type="hidden" name="id" value="@item.Id" />
						<button type="submit" class="btn btn-danger">Delete</button>
					</form>
				</div>
			</div>
		}
	}
}

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			var makeSelect = document.getElementById('makeSelect');
			var modelSelect = document.getElementById('modelSelect');
			var trimSelect = document.getElementById('trimSelect');

			function clearModels() {
				modelSelect.innerHTML = '<option value="">-- Choisir --</option>';
			}

			function clearTrims() {
				trimSelect.innerHTML = '<option value="">-- Choisir --</option>';
			}

			makeSelect?.addEventListener('change', function () {
				var makeId = this.value;
				clearModels();
				clearTrims();
				if (!makeId) return;

				fetch('@Url.Action("GetModelsByMake", "Cars")?makeId=' + encodeURIComponent(makeId))
					.then(function (res) { return res.json(); })
					.then(function (data) {
						data.forEach(function (m) {
							var opt = document.createElement('option');
							opt.value = m.id;
							opt.text = m.name;
							modelSelect.appendChild(opt);
						});
					})
					.catch(function (err) { console.error(err); });
			});

			modelSelect?.addEventListener('change', function () {
				var modelId = this.value;
				clearTrims();
				if (!modelId) return;

				fetch('@Url.Action("GetTrimsByModel", "Cars")?modelId=' + encodeURIComponent(modelId))
					.then(function (res) { return res.json(); })
					.then(function (data) {
						data.forEach(function (m) {
							var opt = document.createElement('option');
							opt.value = m.id;
							opt.text = m.name;
							trimSelect.appendChild(opt);
						});
					})
					.catch(function (err) { console.error(err); });
			});
		});
	</script>
}