@using ExpressVoitures.Helpers 
@model ExpressVoitures.Models.ViewModels.CarViewModel

@{
	ViewData["Title"] = "Create";
	var placeholder = Url.Content("~/images/carImagePlaceHolder.JPG");
	var pictureUrl = string.IsNullOrEmpty(Model?.PictureId) ? placeholder : Url.Action("GetPicture", "Cars", new { pictureId = Model.PictureId });
}

<div><p>Créer une nouvelle voiture</p></div>

@await Html.PartialAsync("_ErrorCreateDelete")

<form asp-action="Create" method="post" enctype="multipart/form-data">
	@Html.AntiForgeryToken()
	<div class="row">
		<div class="mb-3 col-6">
			<label>Marque:</label>
			<select asp-for="Trim.Model.MakeId" id="makeSelect" class="form-select" asp-items="ViewBag.Makes">
				<option value="">-- Choisir --</option>
			</select>
			<span asp-validation-for="Trim.Model.MakeId" class="text-danger"></span>
		</div>
		<div class="mb-3 col-2">
			<a class="button-square" asp-action="Create" asp-controller="CarMakes">+</a>
		</div>
	</div>
	<div class="row">
		<div class="mb-3 col-6">
			<label>Modèle:</label>
			<select asp-for="Trim.ModelId" id="modelSelect" class="form-select" asp-items="ViewBag.Models">
				<option value="">-- Choisir --</option>
			</select>
			<span asp-validation-for="Trim.ModelId" class="text-danger"></span>
		</div>
		<div class="mb-3 col-2">
			<a class="button-square" asp-action="Create" asp-controller="CarModels">+</a>
		</div>
	</div>
	<div class="row">
		<div class="mb-3 col-6">
			<label>Finition:</label>
			<select asp-for="TrimId" id="trimSelect" class="form-select" asp-items="ViewBag.Trims">
				<option value="">-- Choisir --</option>
			</select>
			<span asp-validation-for="TrimId" class="text-danger"></span>
		</div>
		<div class="mb-3 col-2">
			<a class="button-square" asp-action="Create" asp-controller="CarTrims">+</a>
		</div>
	</div>
	<div class="mb-3 col-6">
		<label>VIN code:</label>
		<input asp-for="VinCode" class="form-control" />
		<span asp-validation-for="VinCode" class="text-danger"></span>
	</div>
	<div class="mb-3 col-6">
		<label>Année :</label>
		<input asp-for="Year" class="form-control" />
		<span asp-validation-for="Year" class="text-danger"></span>
	</div>
	<div class="mb-3 col-6">
		<div class="mb-2">
			<img id="picturePreview" src="@pictureUrl" alt="Aperçu photo" class="img-thumbnail" style="max-width:260px; max-height:160px;" />
		</div>
		<label>Photo (jpg/png, max 5MB) :</label>
		<input asp-for="PictureFile" id="pictureFileInput" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif" />
		<span asp-validation-for="PictureFile" class="text-danger"></span>
	</div>

	<div class="text-center">
		<input class="btn btn-primary" type="submit" value="OK" />
	</div>
</form>

@{
	var items = ViewData[ViewDataKeys.ExistingItems] as IEnumerable<ExpressVoitures.Models.ViewModels.CarViewModel>;

	<h4>Voitures existantes</h4>

	if (items != null && items.Any())
	{
		<div class="row">
			<div class="col-2">
				<span>VIN code</span>
			</div>
			<div class="col-2">
				<span>Année</span>
			</div>
			<div class="col-2">
				<span>Marque</span>
			</div>
			<div class="col-2">
				<span>Modèle</span>
			</div>
			<div class="col-2">
				<span>Finition</span>
			</div>
			<div class="col-2">
				<span>Supprimer</span>
			</div>
		</div>
		@foreach (var item in items)
		{
			<div class="row border-top py-2">
				<div class="col-2">
					<span>@item.VinCode</span>
				</div>
				<div class="col-2">
					<span>@item.Year</span>
				</div>
				<div class="col-2">
					@{
						var makeName = item.Trim.Model?.Make?.Name ?? "(Marque inconnue)";
					}
					<span>@makeName</span>
				</div>
				<div class="col-2">
					@{
						var modelName = item.Trim.Model?.Name ?? "(Modèle inconnu)";
					}
					<span>@modelName</span>
				</div>
				<div class="col-2">
					@{
						var trimName = item.Trim?.Name ?? "(Finition inconnue)";
					}
					<span>@trimName</span>
				</div>
				<div class="col-2">
					<form id="@item.Id" asp-action="Delete" asp-controller="Cars" method="post">
						<input type="hidden" name="id" value="@item.Id" />
						<button type="submit" class="btn btn-danger">Delete</button>

						<a asp-action="Edit" asp-controller="Cars" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Éditer</a>
					</form>
				</div>
			</div>
		}
	}
}

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			var makeSelect = document.getElementById('makeSelect');
			var modelSelect = document.getElementById('modelSelect');
			var trimSelect = document.getElementById('trimSelect');

			function clearModels() {
				modelSelect.innerHTML = '<option value="">-- Choisir --</option>';
			}

			function clearTrims() {
				trimSelect.innerHTML = '<option value="">-- Choisir --</option>';
			}

			makeSelect?.addEventListener('change', function () {
				var makeId = this.value;
				clearModels();
				clearTrims();
				if (!makeId) return;

				fetch('@Url.Action("GetModelsByMake", "CarModels")?makeId=' + encodeURIComponent(makeId))
					.then(function (res) { return res.json(); })
					.then(function (data) {
						data.forEach(function (m) {
							var opt = document.createElement('option');
							opt.value = m.id;
							opt.text = m.name;
							modelSelect.appendChild(opt);
						});
					})
					.catch(function (err) { console.error(err); });
			});

			modelSelect?.addEventListener('change', function () {
				var modelId = this.value;
				clearTrims();
				if (!modelId) return;

				fetch('@Url.Action("GetTrimsByModel", "CarTrims")?modelId=' + encodeURIComponent(modelId))
					.then(function (res) { return res.json(); })
					.then(function (data) {
						data.forEach(function (m) {
							var opt = document.createElement('option');
							opt.value = m.id;
							opt.text = m.name;
							trimSelect.appendChild(opt);
						});
					})
					.catch(function (err) { console.error(err); });
			});

						// Preview file input
			var fileInput = document.getElementById('pictureFileInput');
			var preview = document.getElementById('picturePreview');

			fileInput?.addEventListener('change', function (e) {
				var file = this.files && this.files[0];
				if (!file) {
					// restore existing picture or placeholder (server-side set)
					return;
				}
				var reader = new FileReader();
				reader.onload = function (ev) {
					preview.src = ev.target.result;
				};
				reader.readAsDataURL(file);
			});
		});
	</script>
}