@model ExpressVoitures.Models.ViewModels.CarViewModel

@{
	ViewData["Title"] = "Create";
}
<div><p>Créer une nouvelle voiture</p></div>

<form asp-action="Create" method="post">
     @Html.AntiForgeryToken() 
    <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3 col-6">
        <label asp-for="VinCode"></label>
        <input asp-for="VinCode" class="form-control" />
        <span asp-validation-for="VinCode" class="text-danger"></span>
    </div>

    <div class="mb-3 col-4">
        <label asp-for="Year"></label>
        <input asp-for="Year" class="form-control" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="mb-3 col-8">
        <label asp-for="MakeId"></label>
        <input asp-for="MakeId" class="form-control" />
    </div>

    <div class="mb-3 col-4">
        <label asp-for="ModelId"></label>
        <input asp-for="ModelId" class="form-control" />
        <span asp-validation-for="ModelId" class="text-danger"></span>
    </div>

    <div class="mb-3 col-8">
        <label asp-for="TrimId"></label>
        <input asp-for="TrimId" class="form-control" />
    </div>

    <div class="text-center">
        <input class="btn btn-primary" type="submit" value="OK" />
    </div> 
</form>

