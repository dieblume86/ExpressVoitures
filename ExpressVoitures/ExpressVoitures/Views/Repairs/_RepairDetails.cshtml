@model ExpressVoitures.Models.ViewModels.RepairViewModel


<div class="row border-top py-2 align-items-center">
	<div class="col-5">
		<a asp-controller="Repairs" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none text-dark">
			@Model.Description
		</a>
	</div>
	<div class="col-5">
		@Model.RepairCost.ToString("0.00") €
	</div>
	<div class="col-2 text-end">
		<form asp-controller="Repairs" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Confirmer la suppression ?');">
			@Html.AntiForgeryToken()
			<input type="hidden" name="id" value="@Model.Id" />
			<input type="hidden" name="CarId" value="@Model.CarId" />
			<button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
		</form>
		<a asp-action="Edit" asp-controller="Repairs" asp-route-id="@Model.Id" class="btn btn-sm btn-secondary ms-1">Éditer</a>
	</div>
</div>