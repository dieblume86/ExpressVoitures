@using ExpressVoitures.Helpers
@model ExpressVoitures.Models.ViewModels.RepairViewModel

@{
	ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Repair</h4>
<hr />

@await Html.PartialAsync("_ErrorCreateDelete")

<form asp-action="Create" method="post">
	<div class="mb-3 col-6">
		<label>Marque:</label>
		<select asp-for="CarId" class="form-select" asp-items="ViewBag.Cars">
			<option value="">-- Choisir --</option>
		</select>
		<span asp-validation-for="CarId" class="text-danger"></span>
	</div>

	<div class="mb-3 col-6">
		<label>Description:</label>
		<input asp-for="Description" class="form-control" />
		<span asp-validation-for="Description" class="text-danger"></span>
	</div>
	<div class="mb-3 col-6">
		<label>Coût de réparation:</label>
		<input asp-for="RepairCost" class="form-control" />
		<span asp-validation-for="RepairCost" class="text-danger"></span>
	</div>
	<div class="text-center">
		<input class="btn btn-primary" type="submit" value="OK" />
	</div>
</form>

