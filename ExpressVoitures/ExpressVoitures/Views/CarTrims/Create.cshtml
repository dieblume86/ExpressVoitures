@model ExpressVoitures.Models.ViewModels.CarTrimViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>CarTrim</h4>
<hr />
@if (TempData["Success"] != null)
{
	<div class="mt-3 alert alert-success" role="alert">
		@TempData["Success"]
	</div>
}
<form asp-action="Create" method="post">
	<div class="mb-3 col-6">
		<label>Marque:</label>
		<select id="makeSelect" class="form-select" asp-items="ViewBag.Makes">
			<option value="">-- Choisir --</option>
		</select>
	</div>

	<div class="mb-3 col-6">
		<label>Modèle:</label>
		<select asp-for="ModelId" id="modelSelect" class="form-select" asp-items="ViewBag.Models">
			<option value="">-- Choisir --</option>
		</select>
		<span asp-validation-for="ModelId" class="text-danger"></span>
	</div>

	<div class="mb-3 col-6">
		<label>Nom Trim:</label>
		<input asp-for="Name" class="form-control" />
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>

	<div class="text-center">
		<input class="btn btn-primary" type="submit" value="OK" />
	</div>
</form>

@{
	var items = ViewData["ExistingItems"] as IEnumerable<ExpressVoitures.Models.ViewModels.CarTrimViewModel>;

	<h4>Trims existants</h4>

	if (items != null && items.Any())
	{
		<div class="row">
			<div class="col-3">
				<span>Marque</span>
			</div>
			<div class="col-3">
				<span>Modèle</span>
			</div>
			<div class="col-3">
				<span>Finition</span>
			</div>
			<div class="col-3">
				<span>Supprimer</span>
			</div>
		</div>
		@foreach (var item in items)
		{
			<div class="row border-top py-2">
				<div class="col-3">
					@{
						var makeName = item.CarModelViewModel?.CarMakeViewModel?.Name ?? "(Marque inconnue)";
					}
					<span>@makeName</span>
				</div>
				<div class="col-3">
					@{
						var modelName = item.CarModelViewModel?.Name ?? "(Modèle inconnu)";
					}
					<span>@modelName</span>
				</div>
				<div class="col-3">
					<span>@item.Name</span>
				</div>
				<div class="col-3">
					<form id="@item.Id" asp-action="Delete" asp-controller="CarModels" method="post">
						<input type="hidden" name="id" value="@item.Id" />
						<button type="submit" class="btn btn-danger">Delete</button>
					</form>
				</div>
			</div>
		}
	}
}


@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			var makeSelect = document.getElementById('makeSelect');
			var modelSelect = document.getElementById('modelSelect');

			function clearModels() {
				modelSelect.innerHTML = '<option value="">-- Choisir --</option>';
			}

			makeSelect?.addEventListener('change', function () {
				var makeId = this.value;
				clearModels();
				if (!makeId) return;

				fetch('@Url.Action("GetModelsByMake", "CarTrims")?makeId=' + encodeURIComponent(makeId))
					.then(function (res) { return res.json(); })
					.then(function (data) {
						data.forEach(function (m) {
							var opt = document.createElement('option');
							opt.value = m.id;
							opt.text = m.name;
							modelSelect.appendChild(opt);
						});
					})
					.catch(function (err) { console.error(err); });
			});
		});
	</script>
}
