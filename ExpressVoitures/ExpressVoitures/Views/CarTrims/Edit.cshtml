@model ExpressVoitures.Models.ViewModels.CarTrimViewModel

@{
	ViewData["Title"] = "Edit";
}

<h1>Modifier le modèle</h1>

@await Html.PartialAsync("_ErrorCreateDelete")

<form asp-action="Edit" method="post">
	@Html.AntiForgeryToken()
	<input asp-for="Id" type="hidden" />

	<div class="mb-3 col-6">
		<label>Marque:</label>
		<select id="makeSelect" class="form-select" asp-items="ViewBag.Makes">
			<option value="">-- Choisir --</option>
		</select>
	</div>

	<div class="mb-3 col-6">
		<label>Modèle:</label>
		<select id="modelSelect" asp-for="ModelId" class="form-select" asp-items="ViewBag.Models">
			<option value="">-- Choisir --</option>
		</select>
		<span asp-validation-for="ModelId" class="text-danger"></span>
	</div>

	<div class="mb-3 col-6">
		<label>Nom:</label>
		<input asp-for="Name" class="form-control" />
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>

	<div class="text-center">
		<button class="btn btn-primary" type="submit">Enregistrer</button>
		<a asp-action="Create" class="btn btn-secondary ms-2">Annuler</a>
	</div>
</form>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}

	<script>
		document.addEventListener('DOMContentLoaded', function () {
			var makeSelect = document.getElementById('makeSelect');
			var modelSelect = document.getElementById('modelSelect');

			function clearModels() {
				modelSelect.innerHTML = '<option value="">-- Choisir --</option>';
			}

			makeSelect?.addEventListener('change', function () {
				var makeId = this.value;
				clearModels();
				if (!makeId) return;

				fetch('@Url.Action("GetModelsByMake", "CarModels")?makeId=' + encodeURIComponent(makeId))
					.then(function (res) { return res.json(); })
					.then(function (data) {
						data.forEach(function (m) {
							var opt = document.createElement('option');
							opt.value = m.id;
							opt.text = m.name;
							modelSelect.appendChild(opt);
						});
					})
					.catch(function (err) { console.error(err); });
			});
		});
	</script>
}